# dependencies
node_modules/

# Expo
.expo/
.metro-cache/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# Native projects generated by `expo prebuild` — regenerate, never commit.
/android
/ios

# Release signing material. NEVER commit. Keep a private backup.
/credentials

# The Pi's exported public CA certificate, copied from the Pi before a build.
# Generated, machine-specific, and must match the Pi — not source.
/certs/*
!/certs/README.md

# Gradle build output captured by the build script.
build-release.log
